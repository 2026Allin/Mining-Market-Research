{
  "hooks": {
    "PreToolUse": [{
      "matcher": "^mcp__mining_market_research__.*",
      "hooks": [{"type": "command", "command": "MMR_HOOK_ALLOW_NETWORK=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"", "timeout": 20}]
    }],
    "PostToolUse": [{
      "matcher": "^mcp__mining_market_research__.*",
      "hooks": [{"type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"", "timeout": 5}]
    }]
  }
}
