{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "MMR_HOOK_ALLOW_NETWORK=1 python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 20
          }
        ],
        "matcher": "^(?:mcp__mining_market_research__|mcp__plugin_mining\\-market\\-research_mining_market_research__|mining_market_research:)([a-z_]+)$"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 5
          }
        ],
        "matcher": "^(?:mcp__mining_market_research__|mcp__plugin_mining\\-market\\-research_mining_market_research__|mining_market_research:)([a-z_]+)$"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/dispatch.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
